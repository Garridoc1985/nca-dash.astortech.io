# ─── Copia este archivo como .env y completa los valores ──────────────────────
# cp .env.example .env

# Clave secreta Flask (cambia esto por algo aleatorio en producción)
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambia_esto_por_una_clave_segura

# Puerto del servidor NCA Dashboard
NCA_PORT=5000

# Puerto del servidor de Ventas
VENTAS_PORT=5001

# Entorno: development o production
FLASK_ENV=production

# Ruta al Excel NCA (solo para ejecución local sin subir archivo)
# Windows: C:\Users\TuUsuario\Desktop\EERR Flujo de caja_NCA_Final.xlsx
# Linux:   /home/usuario/nca/EERR_Flujo_de_caja_NCA_Final.xlsx
EXCEL_NCA_PATH=

# API Key de Anthropic (solo necesaria para agentes/inspector.py y mapper.py)
ANTHROPIC_API_KEY=
