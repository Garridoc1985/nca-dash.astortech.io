# Normalizar line endings: LF en repo, checkout según OS
* text=auto

# Python y scripts siempre LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binarios sin conversión
*.xlsx binary
*.png binary
*.jpg binary
*.pdf binary
